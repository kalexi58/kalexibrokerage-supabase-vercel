import { createFileRoute, Link } from "@tanstack/react-router";
import { useQuery } from "@tanstack/react-query";
import { useState } from "react";
import { supabase } from "@/integrations/supabase/client";
import { AppShell, PageHeader } from "@/components/AppShell";
import { useSession } from "@/hooks/useSession";
import { allows } from "@/lib/rbac";
import { EmptyState, NoAccess, StatusPill, Panel } from "@/components/records";
import { titleCase } from "@/lib/records";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";

export const Route = createFileRoute("/_authenticated/risk/search")({
  head: () => ({
    meta: [
      { title: "Internal Intelligence Search - Kalexi Brokerage" },
      {
        name: "description",
        content: "Search internal risk cases, clients and opportunities.",
      },
      { name: "robots", content: "noindex" },
    ],
  }),
  component: RiskSearchPage,
});

function escapeFilterValue(value: string) {
  return value.replace(/[\\,().]/g, "\\$&");
}

function searchablePattern(value: string) {
  return `%${escapeFilterValue(value.trim())}%`;
}

function RiskSearchPage() {
  const { data: session } = useSession();
  const access = session?.access;
  const [term, setTerm] = useState("");
  const [query, setQuery] = useState("");
  const canSearch = allows(access, "risk.view");
  const normalizedQuery = query.trim();

  const results = useQuery({
    queryKey: ["risk-search", normalizedQuery],
    enabled: canSearch && normalizedQuery.length >= 2,
    retry: 1,
    queryFn: async () => {
      const pattern = searchablePattern(normalizedQuery);

      const [risk, clients, opportunities] = await Promise.all([
        supabase
          .from("risk_cases")
          .select(
            "id, case_ref, case_kind, subject_name, subject_company, subject_phone, subject_email, subject_identifier, severity, status",
          )
          .is("archived_at", null)
          .or(
            [
              `subject_name.ilike.${pattern}`,
              `subject_company.ilike.${pattern}`,
              `subject_phone.ilike.${pattern}`,
              `subject_email.ilike.${pattern}`,
              `subject_identifier.ilike.${pattern}`,
              `case_ref.ilike.${pattern}`,
            ].join(","),
          )
          .limit(50),

        supabase
          .from("clients")
          .select("id, client_ref, full_name, company_name, phone, email")
          .is("archived_at", null)
          .or(
            [
              `full_name.ilike.${pattern}`,
              `company_name.ilike.${pattern}`,
              `phone.ilike.${pattern}`,
              `email.ilike.${pattern}`,
              `client_ref.ilike.${pattern}`,
            ].join(","),
          )
          .limit(50),

        supabase
          .from("opportunities")
          .select("id, opportunity_ref, title, owner_name, owner_contact")
          .is("archived_at", null)
          .or(
            [
              `owner_name.ilike.${pattern}`,
              `owner_contact.ilike.${pattern}`,
              `title.ilike.${pattern}`,
              `opportunity_ref.ilike.${pattern}`,
            ].join(","),
          )
          .limit(50),
      ]);

      const failures = [
        { name: "risk cases", error: risk.error },
        { name: "clients", error: clients.error },
        { name: "opportunities", error: opportunities.error },
      ].filter((item) => item.error);

      if (failures.length) {
        console.error("Internal intelligence search failed:", failures);
        throw new Error(
          `Search failed for ${failures.map((item) => item.name).join(", ")}. Check database permissions and connection.`,
        );
      }

      return {
        risk: risk.data ?? [],
        clients: clients.data ?? [],
        opportunities: opportunities.data ?? [],
      };
    },
  });

  if (!canSearch) {
    return (
      <AppShell>
        <PageHeader title="Internal intelligence search" />
        <NoAccess module="Risk & Investigation" />
      </AppShell>
    );
  }

  const data = results.data;
  const totalHits = data
    ? data.risk.length + data.clients.length + data.opportunities.length
    : 0;

  function submitSearch() {
    const value = term.trim();
    if (value.length >= 2) setQuery(value);
  }

  return (
    <AppShell>
      <PageHeader
        title="Internal intelligence search"
        description="Search existing risk cases, clients and opportunities. External public sources are not searched yet."
      />

      <form
        className="mb-5 flex flex-wrap gap-2"
        onSubmit={(event) => {
          event.preventDefault();
          submitSearch();
        }}
      >
        <Input
          className="max-w-md"
          placeholder="Name, phone, email, company or reference"
          value={term}
          maxLength={160}
          onChange={(event) => setTerm(event.target.value)}
          aria-label="Search internal records"
        />
        <Button
          type="submit"
          disabled={term.trim().length < 2 || results.isFetching}
        >
          {results.isFetching ? "Searching..." : "Search"}
        </Button>
      </form>

      {!normalizedQuery ? (
        <EmptyState
          title="Search internal records"
          hint="Enter at least two characters to begin."
        />
      ) : results.isFetching ? (
        <p className="py-6 text-sm text-muted-foreground">
          Searching internal records...
        </p>
      ) : results.isError ? (
        <div role="alert" className="rounded-md border border-destructive/40 p-4">
          <p className="font-medium">Search could not be completed</p>
          <p className="mt-1 text-sm text-muted-foreground">
            {results.error instanceof Error
              ? results.error.message
              : "An unexpected database error occurred."}
          </p>
          <Button
            className="mt-3"
            variant="outline"
            onClick={() => results.refetch()}
          >
            Retry search
          </Button>
        </div>
      ) : results.isSuccess && totalHits === 0 ? (
        <EmptyState
          title="No matching internal records"
          hint="No matches were returned from the searched records. This does not establish that the subject has no adverse history."
        />
      ) : data ? (
        <div className="space-y-5">
          <p className="text-sm text-muted-foreground">
            {totalHits} records returned. Results are limited to 50 per record type.
          </p>

          <Panel title={`Risk & investigation cases (${data.risk.length})`}>
            {data.risk.length === 0 ? (
              <p className="text-sm text-muted-foreground">No matches.</p>
            ) : (
              <div className="space-y-2">
                {data.risk.map((record) => (
                  <div
                    key={record.id}
                    className="flex flex-wrap items-center justify-between gap-3 rounded-md border p-3"
                  >
                    <div>
                      <Link
                        to="/risk/$caseId"
                        params={{ caseId: record.id }}
                        className="text-sm font-medium hover:underline"
                      >
                        {record.subject_name || "Unnamed subject"}
                      </Link>
                      <p className="text-xs text-muted-foreground">
                        {record.case_ref} · {titleCase(record.case_kind)} · {record.subject_company || "Company not recorded"}
                      </p>
                      <p className="mt-1 text-xs text-muted-foreground">
                        {record.subject_phone || ""}
                        {record.subject_phone && record.subject_email ? " · " : ""}
                        {record.subject_email || ""}
                      </p>
                    </div>
                    <StatusPill value={record.severity} />
                  </div>
                ))}
              </div>
            )}
          </Panel>

          <Panel title={`Clients (${data.clients.length})`}>
            {data.clients.length === 0 ? (
              <p className="text-sm text-muted-foreground">No matches.</p>
            ) : (
              <div className="space-y-2">
                {data.clients.map((client) => (
                  <div key={client.id} className="rounded-md border p-3">
                    <Link
                      to="/clients/$clientId"
                      params={{ clientId: client.id }}
                      className="text-sm font-medium hover:underline"
                    >
                      {client.full_name || client.company_name || "Unnamed client"}
                    </Link>
                    <p className="text-xs text-muted-foreground">
                      {client.client_ref}
                      {client.company_name ? ` · ${client.company_name}` : ""}
                    </p>
                    <p className="mt-1 text-xs text-muted-foreground">
                      {client.phone || ""}
                      {client.phone && client.email ? " · " : ""}
                      {client.email || ""}
                    </p>
                  </div>
                ))}
              </div>
            )}
          </Panel>

          <Panel title={`Opportunities (${data.opportunities.length})`}>
            {data.opportunities.length === 0 ? (
              <p className="text-sm text-muted-foreground">No matches.</p>
            ) : (
              <div className="space-y-2">
                {data.opportunities.map((opportunity) => (
                  <div key={opportunity.id} className="rounded-md border p-3">
                    <Link
                      to="/opportunities/$opportunityId"
                      params={{ opportunityId: opportunity.id }}
                      className="text-sm font-medium hover:underline"
                    >
                      {opportunity.title}
                    </Link>
                    <p className="text-xs text-muted-foreground">
                      {opportunity.opportunity_ref} · {opportunity.owner_name || "Owner not recorded"}
                    </p>
                    {opportunity.owner_contact ? (
                      <p className="mt-1 text-xs text-muted-foreground">
                        {opportunity.owner_contact}
                      </p>
                    ) : null}
                  </div>
                ))}
              </div>
            )}
          </Panel>
        </div>
      ) : null}
    </AppShell>
  );
}

import { useEffect, useState } from "react";

type Holiday = {
  date: string;
  name?: string;
  localName?: string;
};

export default function HolidayLoginAnnouncement() {
  const [holiday, setHoliday] = useState<Holiday | null>(null);
  const [visible, setVisible] = useState(false);
  const [soundReady, setSoundReady] = useState(false);

  useEffect(() => {
    let cancelled = false;

    async function checkHoliday() {
      const today = new Date().toLocaleDateString("en-CA", {
        timeZone: "Africa/Kampala",
      });

      try {
        const response = await fetch(
          `https://date.nager.at/api/v3/PublicHolidays/${today.slice(0, 4)}/UG`
        );
        if (!response.ok) return;

        const data: Holiday[] = await response.json();
        const todaysHoliday = data.find((item) => item.date === today);
        if (!todaysHoliday || cancelled) return;

        setHoliday(todaysHoliday);

        // One announcement per browser tab session, so route changes
        // do not repeatedly celebrate the same holiday.
        const key = `kalexi-holiday-announced-${today}-${todaysHoliday.name ?? "holiday"}`;
        if (sessionStorage.getItem(key)) return;

        sessionStorage.setItem(key, "shown");
        setVisible(true);

        // Browser notifications are attempted only if permission
        // has already been granted. We never spam permission prompts.
        if ("Notification" in window && Notification.permission === "granted") {
          new Notification(`🎉 ${todaysHoliday.name ?? "Public holiday"}`, {
            body: "Kalexi wishes you a happy holiday!",
          });
        }
      } catch {
        // The in-app announcement depends on the holiday data service.
      }
    }

    void checkHoliday();
    return () => { cancelled = true; };
  }, []);

  function playCelebration() {
    try {
      const AudioContextClass =
        window.AudioContext ||
        (window as typeof window & { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
      if (!AudioContextClass) return;

      const context = new AudioContextClass();
      const start = context.currentTime;

      [523.25, 659.25, 783.99, 1046.5].forEach((frequency, index) => {
        const oscillator = context.createOscillator();
        const gain = context.createGain();
        const time = start + index * 0.14;

        oscillator.frequency.value = frequency;
        oscillator.type = "sine";
        gain.gain.setValueAtTime(0.0001, time);
        gain.gain.exponentialRampToValueAtTime(0.09, time + 0.025);
        gain.gain.exponentialRampToValueAtTime(0.0001, time + 0.22);
        oscillator.connect(gain);
        gain.connect(context.destination);
        oscillator.start(time);
        oscillator.stop(time + 0.24);
      });

      window.setTimeout(() => void context.close(), 1100);
      setSoundReady(true);
    } catch {
      setSoundReady(false);
    }
  }

  if (!visible || !holiday) return null;

  return (
    <div
      role="status"
      aria-live="polite"
      className="fixed right-4 top-4 z-[9999] w-[min(92vw,420px)] overflow-hidden rounded-2xl border border-amber-200 bg-white shadow-2xl"
    >
      <div className="bg-gradient-to-r from-violet-700 via-fuchsia-600 to-amber-500 p-4 text-white">
        <div className="flex items-start justify-between gap-3">
          <div>
            <p className="text-sm font-semibold opacity-90">🌍 KALEXI CELEBRATES</p>
            <h2 className="mt-1 text-xl font-bold">🎉 Happy {holiday.name ?? "Public Holiday"}!</h2>
          </div>
          <button
            type="button"
            aria-label="Dismiss holiday announcement"
            onClick={() => setVisible(false)}
            className="rounded-lg px-2 py-1 text-xl hover:bg-white/20"
          >
            ×
          </button>
        </div>
      </div>
      <div className="p-4">
        <p className="text-sm leading-6 text-slate-700">
          Wishing you a peaceful and joyful holiday. From everyone at Kalexi.
        </p>
        <div className="mt-4 flex flex-wrap gap-2">
          <button
            type="button"
            onClick={playCelebration}
            className="rounded-xl bg-violet-700 px-4 py-2 text-sm font-semibold text-white hover:bg-violet-800"
          >
            🔔 Play celebration sound
          </button>
          <button
            type="button"
            onClick={() => setVisible(false)}
            className="rounded-xl border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50"
          >
            Close
          </button>
        </div>
        <p className="mt-2 text-xs text-slate-500">
          {soundReady ? "Celebration sound played." : "Press the sound button to allow playback in your browser."}
        </p>
      </div>
    </div>
  );
}

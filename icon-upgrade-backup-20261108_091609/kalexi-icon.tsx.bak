type KalexiIconProps = {
  name: KalexiIconName;
  size?: number;
  variant?: "plain" | "soft" | "filled";
  className?: string;
  strokeWidth?: number;
};

export function KalexiIcon({
  name,
  size = 20,
  variant = "plain",
  className,
  strokeWidth = 2,
}: KalexiIconProps) {
  const Icon = KALEXI_ICON_MAP[name];
  const color = COLOR_BY_ICON[name];

  if (variant === "plain") {
    return (
      <Icon
        size={size}
        color={color}
        strokeWidth={strokeWidth}
        className={className}
        aria-hidden="true"
      />
    );
  }

  if (variant === "filled") {
    return (
      <span
        className={`inline-flex shrink-0 items-center justify-center rounded-xl ${className ?? ""}`}
        style={{
          width: size + 18,
          height: size + 18,
          backgroundColor: color,
          color: "#FFFFFF",
        }}
      >
        <Icon size={size} color="#FFFFFF" strokeWidth={2.2} aria-hidden="true" />
      </span>
    );
  }

  return (
    <span
      className={`inline-flex shrink-0 items-center justify-center rounded-xl ${className ?? ""}`}
      style={{
        width: size + 18,
        height: size + 18,
        backgroundColor: BACKGROUND_BY_ICON[name],
      }}
    >
      <Icon size={size} color={color} strokeWidth={2.2} aria-hidden="true" />
    </span>
  );
}

type KalexiHeadingProps = {
  title: string;
  subtitle?: string;
  icon: KalexiIconName;
  size?: number;
  children?: React.ReactNode;
};

export function KalexiPageHeading({
  title,
  subtitle,
  icon,
  size = 25,
  children,
}: KalexiHeadingProps) {
  return (
    <div className="flex flex-wrap items-center justify-between gap-4">
      <div className="flex min-w-0 items-center gap-3">
        <KalexiIcon name={icon} size={size} variant="soft" />
        <div className="min-w-0">
          <h1 className="text-xl font-bold tracking-tight sm:text-2xl">
            {title}
          </h1>
          {subtitle && (
            <p className="mt-1 text-sm text-muted-foreground">{subtitle}</p>
          )}
        </div>
      </div>
      {children}
    </div>
  );
}

export function KalexiSectionHeading({
  title,
  icon,
  children,
}: {
  title: string;
  icon: KalexiIconName;
  children?: React.ReactNode;
}) {
  return (
    <div className="flex items-center justify-between gap-3">
      <div className="flex items-center gap-2.5">
        <KalexiIcon name={icon} size={18} />
        <h2 className="text-base font-semibold">{title}</h2>
      </div>
      {children}
    </div>
  );
}
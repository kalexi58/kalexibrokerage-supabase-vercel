function PageDirectory() {
  const [query, setQuery] = useState("");
  const [group, setGroup] = useState("All pages");

  const groups = useMemo(
    () => ["All pages", ...Array.from(new Set(discoveredRoutes.map(r => r.group))).sort()],
    []
  );

  const filtered = useMemo(() => {
    const q = query.trim().toLowerCase();
    return discoveredRoutes.filter(route => {
      const matchesQuery =
        !q ||
        route.title.toLowerCase().includes(q) ||
        route.path.toLowerCase().includes(q) ||
        route.group.toLowerCase().includes(q);

      const matchesGroup = group === "All pages" || route.group === group;
      return matchesQuery && matchesGroup;
    });
  }, [query, group]);

  const grouped = useMemo(() => {
    return filtered.reduce<Record<string, typeof filtered>>((acc, route) => {
      (acc[route.group] ??= []).push(route);
      return acc;
    }, {});
  }, [filtered]);

  return (
    <main className="min-h-screen space-y-6 bg-slate-50 p-4 text-slate-900 sm:p-6 lg:p-8">
      <header>
        <div className="mb-2 flex items-center gap-2 text-sm font-semibold text-blue-700">
          <LayoutDashboard size={17} />
          KALEXI BROKERAGE OPERATING SYSTEM
        </div>
        <h1 className="text-3xl font-bold tracking-tight">Company Page Directory</h1>
        <p className="mt-2 max-w-2xl text-sm text-slate-600">
          Find registered application pages, including pages that are not
          currently listed in the main navigation.
        </p>
      </header>

      <section className="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
        <div className="flex flex-col gap-3 md:flex-row">
          <label className="relative min-w-0 flex-1">
            <span className="sr-only">Search pages</span>
            <Search className="absolute left-3 top-3 text-slate-400" size={18} />
            <input
              value={query}
              onChange={event => setQuery(event.target.value)}
              placeholder="Search by page name, route or category..."
              className="w-full rounded-xl border border-slate-200 py-2.5 pl-10 pr-3 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100"
            />
          </label>

          <label>
            <span className="sr-only">Filter pages by category</span>
            <select
              value={group}
              onChange={event => setGroup(event.target.value)}
              className="w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 md:min-w-52"
            >
              {groups.map(item => <option key={item}>{item}</option>)}
            </select>
          </label>
        </div>

        <div className="mt-4 flex items-center justify-between text-sm text-slate-500">
          <span>{filtered.length} page{filtered.length === 1 ? "" : "s"} found</span>
          <span className="inline-flex items-center gap-1">
            <ShieldCheck size={15} />
            Existing route protections remain in force
          </span>
        </div>
      </section>

      {filtered.length === 0 ? (
        <section className="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center">
          <FolderOpen className="mx-auto text-slate-400" size={28} />
          <p className="mt-3 font-semibold">No matching pages</p>
          <p className="mt-1 text-sm text-slate-500">
            Try another search or select a different category.
          </p>
        </section>
      ) : (
        <div className="space-y-7">
          {Object.entries(grouped).sort(([a], [b]) => a.localeCompare(b)).map(([category, routes]) => (
            <section key={category}>
              <h2 className="mb-3 text-lg font-bold">{category}</h2>
              <div className="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
                {routes.map(route => (
                  <a
                    key={route.path}
                    href={route.path}
                    className="group flex min-w-0 items-start justify-between gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:border-blue-300 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                  >
                    <div className="min-w-0">
                      <p className="font-semibold group-hover:text-blue-700">{route.title}</p>
                      <p className="mt-1 break-all text-xs text-slate-500">{route.path}</p>
                    </div>
                    <ExternalLink className="mt-1 shrink-0 text-slate-400 group-hover:text-blue-700" size={17} />
                  </a>
                ))}
              </div>
            </section>
          ))}
        </div>
      )}

      <footer className="border-t border-slate-200 pt-4 text-xs text-slate-500">
        This directory lists routes discovered in the source code. It does not
        reveal unregistered components, server-only endpoints, or grant new
        permissions.
      </footer>
    </main>
  );
}
